<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de logging para mi-extractor (la usan tanto la app web Spring Boot
  como el CLI). Consola en UTF-8 (arregla acentos/emojis ilegibles) + archivo con
  rotación diaria. Para ver logs DEBUG, cambia el nivel del logger com.extractor a DEBUG.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/mi-extractor.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/mi-extractor.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Ruido de terceros bajado a WARN -->
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <logger name="com.extractor.mi_extractor" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
